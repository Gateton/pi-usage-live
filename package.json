  "description": "Always-on subscription usage card for Pi: see how much of your Claude, ChatGPT Codex, OpenCode Zen and OpenRouter allowance you have left, live in your terminal, without asking.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "pi-plugin",
    "ai",
    "coding-agent",
    "cli",
    "tui",
    "terminal",
    "usage",
    "quota",
    "rate-limit",
    "subscription",
    "claude",
    "anthropic",
    "chatgpt",
    "codex",
    "openrouter",
    "deepseek",
    "kimi",
    "minimax",
    "moonshot",
    "zai"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --import ./test/setup.mjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gateton/pi-usage-live.git"
  },
  "bugs": {
